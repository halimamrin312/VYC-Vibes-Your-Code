# Swarm Application Configuration Variables

# Gemini Enterprise / API Key (Required for LLM access)
GEMINI_API_KEY=your_gemini_api_key_here

# CourtListener and GovInfo API Keys (Optional, fallback simulation if blank)
COURTLISTENER_API_TOKEN=your_courtlistener_api_token_here
GOVINFO_API_KEY=your_govinfo_api_key_here

# Server Run Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Diligence Data Settings
DATA_ROOM_DIR=data_room
LOG_LEVEL=INFO
